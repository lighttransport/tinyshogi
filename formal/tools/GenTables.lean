/- Untrusted Lean → C emitter for the attack tables (PLAN.md §4).
   `lake exe gentables > ../src/shogi_tables.h`. Its output is re-imported by
   tools/c2lean.py and checked against `Shogi.Tables` by proof, so this
   program is not part of the trusted base. -/
import Shogi.Tables

open Shogi Shogi.Tables

def join (xs : List String) : String := ", ".intercalate xs
def brace (xs : List String) : String := "{" ++ join xs ++ "}"

def main : IO Unit := do
  let sq := List.finRange 81
  let probesC := colors.map fun c => brace (sq.map fun t =>
    brace ((padTo 10 ⟨0, 0⟩ (probes c t)).map fun p => s!"\{{p.square}, {p.mask}}"))
  let countC := colors.map fun c => brace (sq.map fun t => toString (probes c t).length)
  let raysC := sq.map fun t => brace (rayDirs.map fun d =>
    brace ((padTo 8 0 (raySquares t d)).map toString))
  let lenC := sq.map fun t => brace (rayDirs.map fun d => toString (raySquares t d).length)
  let masksC := colors.map fun c => brace (sq.map fun _ =>
    brace (rayDirs.map fun d => toString (rayMask c d)))
  IO.println "/* GENERATED by formal/tools/GenTables.lean from formal/Shogi/Tables.lean."
  IO.println " * Do not edit. Regenerate: cd formal && lake exe gentables > ../src/shogi_tables.h"
  IO.println " * Checked against the Lean definitions by formal/Shogi/C/Proofs/Tables.lean. */"
  IO.println "#ifndef TINYSHOGI_SHOGI_TABLES_H"
  IO.println "#define TINYSHOGI_SHOGI_TABLES_H"
  IO.println ""
  IO.println s!"static const StepAttackProbe step_attack_probes[2][SHOGI_SQUARES][10] = {brace probesC};"
  IO.println s!"static const uint8_t step_attack_probe_count[2][SHOGI_SQUARES] = {brace countC};"
  IO.println s!"static const uint8_t attack_rays[SHOGI_SQUARES][8][8] = {brace raysC};"
  IO.println s!"static const uint8_t attack_ray_length[SHOGI_SQUARES][8] = {brace lenC};"
  IO.println s!"static const uint16_t attack_ray_masks[2][SHOGI_SQUARES][8] = {brace masksC};"
  IO.println ""
  IO.println "#endif"
